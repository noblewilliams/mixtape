{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mockups",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4310", "--directory", "docs/mockups"],
      "port": 4310
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "server", "run", "dev", "--", "--port", "8799"],
      "port": 8799
    },
    {
      "name": "web",
      "runtimeExecutable": "env",
      "runtimeArgs": ["VITE_API_URL=http://localhost:8799", "npm", "--prefix", "web", "run", "dev", "--", "--port", "4176", "--strictPort"],
      "port": 4176
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev", "--", "--port", "4179", "--strictPort"],
      "port": 4179
    }
  ]
}
