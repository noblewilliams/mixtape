{
  "name": "mixtape-server",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "npx @better-auth/cli@latest generate --config src/auth/cli-config.ts --output src/db/auth-schema.ts -y",
    "dj": "tsx scripts/dj-chat.ts",
    "retitle-sessions": "tsx scripts/retitle-sessions.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@hono/zod-validator": "^0.9.0",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@types/node": "^26.4.0",
    "drizzle-kit": "^0.31.10",
    "essentia.js": "^0.1.3",
    "node-wav": "^0.0.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.110.0"
  }
}
