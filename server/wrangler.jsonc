{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mixtape-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  // Shared mixes (spec 2026-11-13): GET /shared/:token, 60 a minute per IP
  // (CF-Connecting-IP). src/index.ts buildShares refuses to start without it.
  // namespace_id is an arbitrary account-unique integer string.
  "ratelimits": [
    {
      "name": "SHARE_READ_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // Durable mix turns (spec 2026-11-21): one TurnRunner object per session
  // runs its mix turn on an alarm, off the request, so a client that drops
  // or backgrounds no longer loses the turn. The class is exported from
  // src/index.ts. Nothing routes to it unless DURABLE_TURNS is "on" (vars);
  // with it on and this binding missing, src/index.ts buildDurableTurns
  // refuses to start. Migration tags are permanent once deployed: add a new
  // tag for any later class change, never edit v1.
  "durable_objects": {
    "bindings": [{ "name": "TURN_RUNNER", "class_name": "TurnRunner" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TurnRunner"] }],
  // Maintenance on the hour, then enrichment two minutes later while Postgres
  // is still awake. 22 and 42 are enrichment-only runs (no maintenance).
  // Dispatched on event.cron (src/enrich/scheduled.ts); keep the two in step.
  // The free plan allows 5 triggers per account; one stays spare.
  "triggers": {
    "crons": ["0 * * * *", "2 * * * *", "12 * * * *", "22 * * * *", "32 * * * *", "42 * * * *", "52 * * * *"]
  },
  "vars": {
    // Public OAuth identifier, not a secret — it ships with `wrangler deploy`,
    // no `wrangler secret put` needed. Native iOS google_sign_in stamps this
    // as the ID token's `aud`, so Better Auth must accept it alongside the web
    // GOOGLE_CLIENT_ID secret. Keep it equal to GOOGLE_IOS_CLIENT_ID in
    // client/config/google-ios.json.
    "GOOGLE_IOS_CLIENT_ID": "403264926110-000q34va63qouvvtvb11co0je53867gb.apps.googleusercontent.com",
    // Album picks (plan 2026-10-20, Gate 2 on 2026-10-21): "on" lets listeners
    // ask the DJ for an album. Anything else is off.
    "ALBUM_PICKS": "on",
    // Never refuse (plan 2026-10-21 everyone-gets-a-mix, Task 7): "on" gives a
    // listener with too few seeds songs the DJ proposes, verified on Apple,
    // instead of a refusal. Anything else is off.
    "NEVER_REFUSE": "on",
    // Propose first (plan 2026-11-16, S7): "on" blends songs the DJ proposes,
    // verified on Apple, into personal mixes and raises the corpus share.
    // Anything else is off: the kill switch back to the pre-propose-first DJ.
    "PROPOSE_FIRST": "on",
    // AI consent (plan 2026-11-02): "enforce" refuses mixes, turns and voice
    // to listeners who have not agreed. Off until clients that ask are live.
    "AI_CONSENT": "off",
    // DJ paused (2026-11-16): "on" when the model is unavailable to us
    // (Anthropic credits spent, an outage). Refuses new mixes and changes to
    // mixes with 503 dj_paused; /health reports djPaused so web and iOS close
    // the composer with a calm notice. Playing, playlists and sharing stay
    // open. Anything else is open. Flip, commit, deploy; flip back the same way.
    // The server also pauses itself when Anthropic refuses us for billing and
    // reopens once credits answer again (src/dj/auto-pause.ts, dj_pauses
    // table); this switch is for everything else.
    "DJ_PAUSED": "off",
    // Shared mixes (spec 2026-11-13): share links are <SHARE_BASE_URL>/m/<token>.
    // Required; src/index.ts buildShares fails fast without it.
    "SHARE_BASE_URL": "https://miixtape.netlify.app",
    // Durable mix turns (spec 2026-11-21): "on" runs POST /sessions and
    // /sessions/:id/messages mix turns in the TURN_RUNNER object above, and
    // their streams carry the `turn` event. Anything else is today's
    // in-request turn. Off: flip back the same way; turns already in an
    // object still finish there.
    "DURABLE_TURNS": "on",
    // Mix-ready push (spec 2026-11-21): "on" pushes a turn's end to the
    // listener's devices when no client saw it. Anything else sends none.
    // "on" requires APNS_KEY_ID, APNS_PRIVATE_KEY, VAPID_PUBLIC_KEY,
    // VAPID_PRIVATE_KEY and VAPID_SUBJECT (every request fails without them,
    // src/index.ts buildPush), and serves VAPID_PUBLIC_KEY on /health.
    "TURN_PUSH": "off"
    // Web push VAPID public half and contact, both public. Uncomment with
    // real values (`npx tsx scripts/vapid-keys.ts` prints a pair) before
    // TURN_PUSH goes on:
    // "VAPID_PUBLIC_KEY": "<base64url uncompressed P-256 point>",
    // "VAPID_SUBJECT": "mailto:<contact>"
    // Optional: APNS_TOPIC, the APNs topic (defaults to APPLE_BUNDLE_ID).
  }
  // Secrets required at runtime (set via `wrangler secret put` / .dev.vars locally) —
  // createAuth fails fast if any is missing:
  //   DATABASE_URL            — Neon connection string
  //   BETTER_AUTH_SECRET      — Better Auth signing secret (min 32 chars)
  //   BETTER_AUTH_URL         — deployed worker origin (http://localhost:8787 locally)
  //   APPLE_BUNDLE_ID         — native app ID / Apple idToken audience
  //   APPLE_WEB_CLIENT_ID     — Sign in with Apple Services ID for web
  //   APPLE_TEAM_ID           — Apple Developer team ID
  //   APPLE_KEY_ID            — Sign in with Apple key ID
  //   APPLE_PRIVATE_KEY       — downloaded .p8 key (multiline or escaped newlines)
  //   GOOGLE_CLIENT_ID        — Google OAuth web client ID
  //   GOOGLE_CLIENT_SECRET    — Google OAuth web client secret
  //   WEB_ORIGINS             — exact comma-separated web origins allowed to use cookies/CORS
  //   MUSICKIT_KEY_ID         — Apple Music private-key ID; set with MUSICKIT_PRIVATE_KEY to enable /musickit/*
  //   MUSICKIT_PRIVATE_KEY    — Apple Music .p8 key; never reuse or commit the downloaded key file
  //   APNS_KEY_ID             — APNs auth key ID (Keys → Apple Push Notifications service); required when TURN_PUSH is "on"
  //   APNS_PRIVATE_KEY        — APNs .p8 key (multiline or escaped newlines); required when TURN_PUSH is "on"; never paste or commit it
  //   VAPID_PRIVATE_KEY       — web push VAPID private scalar, base64url (scripts/vapid-keys.ts); required when TURN_PUSH is "on"
  // ENRICH_ADMIN_TOKEN        — admin guard for /enrich/*; unset disables the route group entirely
  //   ANTHROPIC_API_KEY       — DJ engine (Sonnet 5 agent loop); unset disables /sessions/* entirely
  //   GROQ_API_KEY            — Groq Whisper key for POST /transcribe (voice capture); unset makes that one route answer 503, rest of the API unaffected
  // Optional vars (not secrets):
  //   ITUNES_STOREFRONT       — iTunes storefront code for enrichment lookups (default "ng")
  //   GOOGLE_IOS_CLIENT_ID    — iOS OAuth client id, declared under "vars" above; accepted as an
  //                             additional Google ID token audience for native sign-in
  //   ALBUM_PICKS             declared under "vars" above; read once per request in src/index.ts
  //   NEVER_REFUSE            declared under "vars" above; read once per request in src/index.ts
  //   PROPOSE_FIRST           declared under "vars" above; read once per request in src/index.ts
  //   DURABLE_TURNS           declared under "vars" above; read once per request in src/index.ts
  //   TURN_PUSH               declared under "vars" above; read by the turn's notify
  // MusicKit keys also enable the server-only Apple catalog client used by artwork enrichment.
}
