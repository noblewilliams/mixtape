{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mixtape-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
  // Secrets required at runtime (set via `wrangler secret put` / .dev.vars locally) —
  // createAuth fails fast if any is missing:
  //   DATABASE_URL            — Neon connection string
  //   BETTER_AUTH_SECRET      — Better Auth signing secret (min 32 chars)
  //   BETTER_AUTH_URL         — deployed worker origin (http://localhost:8787 locally)
  //   APPLE_BUNDLE_ID         — native app ID / Apple idToken audience
  //   APPLE_WEB_CLIENT_ID     — Sign in with Apple Services ID for web
  //   APPLE_TEAM_ID           — Apple Developer team ID
  //   APPLE_KEY_ID            — Sign in with Apple key ID
  //   APPLE_PRIVATE_KEY       — downloaded .p8 key (multiline or escaped newlines)
  //   WEB_ORIGINS             — exact comma-separated web origins allowed to use cookies/CORS
  //   MUSICKIT_KEY_ID         — Apple Music private-key ID; set with MUSICKIT_PRIVATE_KEY to enable /musickit/*
  //   MUSICKIT_PRIVATE_KEY    — Apple Music .p8 key; never reuse or commit the downloaded key file
  // ENRICH_ADMIN_TOKEN        — admin guard for /enrich/*; unset disables the route group entirely
  //   ANTHROPIC_API_KEY       — DJ engine (Sonnet 5 agent loop); unset disables /sessions/* entirely
  // Optional var (not secret):
  //   ITUNES_STOREFRONT       — iTunes storefront code for enrichment lookups (default "ng")
  // Later phases add: MusicKit developer-token key (P2 catalog).
}
