{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mixtape-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  }
  // Secrets required at runtime (set via `wrangler secret put` / .dev.vars locally) —
  // createAuth fails fast if any is missing:
  //   DATABASE_URL            — Neon connection string
  //   BETTER_AUTH_SECRET      — Better Auth signing secret (min 32 chars)
  //   BETTER_AUTH_URL         — deployed worker origin (http://localhost:8787 locally)
  //   APPLE_BUNDLE_ID         — com.mixtape.mixtape (Apple idToken audience)
  // Later phases add: ANTHROPIC_API_KEY (P3 curation), MusicKit developer-token key (P2 catalog).
}
